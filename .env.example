# Conexão com o PostgreSQL.
# Local (Docker Compose deste projeto):
DATABASE_URL="postgresql://ensalamento:ensalamento@localhost:5432/ensalamento"
# Neon / Supabase / Render: cole aqui a connection string que o serviço te der.
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Assine os cookies de sessão. Troque por qualquer string longa e aleatória.
JWT_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# Conta de coordenação criada pelo `npm run seed`.
ADMIN_NOME="Gustavo Braga"
ADMIN_EMAIL="prof.gustavo.braga@soulasalle.com.br"
ADMIN_SENHA="troque-esta-senha"

PORT=3333
